# NicTool Monorepo environment configuration
# Copy to docker/.env, or run: ./docker/generate-env.sh

# --- Database (MariaDB) ---
DB_ROOT_PASSWORD=changeme
NICTOOL_DB_NAME=nictool
NICTOOL_DB_USER=nictool
NICTOOL_DB_USER_PASSWORD=changeme

# --- Legacy NicTool v2 ---
ROOT_USER_EMAIL=admin@example.com
ROOT_USER_PASSWORD=changeme

# --- Port mapping (optional) ---
# DB_PORT=3307
# API_PORT=3000
# SERVER_PORT=8080
# LEGACY_HTTP_PORT=8082
# LEGACY_HTTPS_PORT=8443
